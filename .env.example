# ------------------------------------------------------------------
# DocuGuard environment variables
# Copy this file to .env.local for local development, and set the
# same variables in the Render dashboard (Settings > Environment).
# ------------------------------------------------------------------

# REQUIRED for live AI forensic analysis (get one at https://console.groq.com/keys)
# Leave empty to run DocuGuard in local-only heuristic mode.
GROQ_API_KEY=

# Optional: override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# Node runtime (Render reads this from package.json engines)
NODE_VERSION=22
